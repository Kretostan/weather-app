		"firebase-functions": "^7.0.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.5",
		"@types/morgan": "^1.9.10",
		"@types/node": "^24.10.1",
		"firebase-functions-test": "^3.1.0",
		"nodemon": "^3.1.11",
